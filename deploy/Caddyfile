# Public entry point for the dashboard.
#
# Caddy terminates TLS for PUBLIC_HOSTNAME, enforces basic auth, and only then
# proxies to the bot on the internal compose network. The bot publishes no
# public port, so this is the only route in.
#
# Set in deploy/caddy.env (written by deploy/enable-public.sh):
#   PUBLIC_HOSTNAME   the name this is served as
#   TLS_ARG           an email address  -> public ACME certificate
#                     the word internal -> Caddy's own CA, for a CDN origin
#   BASIC_AUTH_USER   login name
#   BASIC_AUTH_HASH   bcrypt hash: docker run --rm caddy:2.8-alpine \
#                       caddy hash-password --plaintext 'yourpassword'

{$PUBLIC_HOSTNAME} {
	# TLS_ARG is either an email address, which makes Caddy obtain a public
	# ACME certificate, or the literal word "internal", which makes it use its
	# own CA. "internal" is what you want when a CDN such as Cloudflare
	# terminates TLS for visitors and only has to accept this origin itself:
	# public issuance would need the CDN out of the path, and the CDN's "Full"
	# mode accepts any origin certificate.
	tls {$TLS_ARG}

	encode zstd gzip

	# Gate everything, including the read-only panels. A port scanner should
	# find a password prompt, not a trading dashboard.
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The dashboard loads only its own CSS/JS and talks only to its own
		# origin, so this can be strict.
		Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	reverse_proxy arb-bot:8000 {
		health_uri /api/status
		health_interval 30s
	}

	log {
		output stdout
		format console
	}
}
