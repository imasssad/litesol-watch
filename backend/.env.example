APP_NAME=Arb Bot Production v1
ENVIRONMENT=local
# Control endpoints stay DISABLED (HTTP 503) while this is the placeholder,
# and the app refuses to start with live execution enabled until it is changed.
API_AUTH_TOKEN=change-me-long-random-token

# LIVE TRADING IS BLOCKED UNLESS BOTH ARE TRUE.
LIVE_TRADING=false
EXECUTION_ENABLED=false

PAIR=SOL/USDC
BASE_ASSET=SOL
QUOTE_ASSET=USDC
TRADE_SIZE_USD=100
MIN_NET_SPREAD_BPS=65
MAX_TRADE_USD=250
MAX_DAILY_LOSS_USD=100
MAX_SLIPPAGE_BPS=35
MAX_QUOTE_AGE_SECONDS=2.0
MAX_CONSECUTIVE_FAILURES=3
SCAN_INTERVAL_SECONDS=2

CEX_VENUE=binance
CEX_FEE_BPS=10
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TESTNET=false

DEX_VENUE=jupiter
DEX_FEE_BPS=5
# quote-api.jup.ag/v6 was RETIRED on 2025-10-01 and no longer answers.
# Keyless default (rate-limited, ~60 req/min free tier):
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
JUPITER_SWAP_URL=https://lite-api.jup.ag/swap/v1/swap
# With an API key from portal.jup.ag, set the key and use the api.jup.ag host:
#   JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
#   JUPITER_SWAP_URL=https://api.jup.ag/swap/v1/swap
JUPITER_API_KEY=
SOLANA_RPC_URL=
SOLANA_WALLET_PUBLIC_KEY=
SOLANA_PRIVATE_KEY_BASE64=

GAS_BUFFER_USD=0.05
SLIPPAGE_BUFFER_BPS=25
DATABASE_URL=sqlite+aiosqlite:///./data/arb_bot.db

# Optional CEX adapters. Set CEX_VENUE=mexc or CEX_VENUE=bingx to use them.
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_SANDBOX=false

BINGX_API_KEY=
BINGX_API_SECRET=
# Some BingX account/API setups require a password/passphrase; leave blank if not used.
BINGX_API_PASSWORD=
BINGX_SANDBOX=false

# Set CEX_VENUE=mock and DEX_VENUE=mock to run the full stack offline with
# synthetic prices (paper mode only; mock connectors refuse to place orders).

# Public publishing is configured in deploy/caddy.env, NOT here - run
# deploy/enable-public.sh. The proxy is kept away from these credentials
# on purpose.
